<?xml version="1.0"?>
<package format="3">
  <name>jaka_a5_scene_tools</name>
  <version>0.1.0</version>
  <description>Small ROS 2 tools for adding test obstacles to a MoveIt planning scene.</description>

  <maintainer email="you@example.com">Haochen Zhang</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>shape_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

